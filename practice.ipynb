   "source": [
    "def preprocess_image(images):\n",
    "    images_resized = np.array([cv2.resize(img,(32,32)) for img in images])\n",
    "    images_rgb = np.stack((images_resized,)*3, axis=-1)\n",
    "    return images_rgb.astype('float32') / 255.0"
   ]
